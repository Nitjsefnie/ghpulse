# PostgreSQL: dashboard data and external authentication stay separate.
DATABASE_URL_VIZ=postgresql:///ghpulse
DATABASE_URL_AUTH=postgresql:///auth

# Signed browser session.
SESSION_COOKIE=ghpulse_session
COOKIE_SECURE=1

# Required for /admin/* routes (generate a long random value).
ADMIN_TOKEN=change-me-32-byte-random

# One server-side GitHub source identity (used by later ingest tasks).
GH_USER=
GH_TOKEN=
GH_EXTRA_INSIDERS=
GH_SNAPSHOT_FILE=
