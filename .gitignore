# Deny-by-default. `*` ignores everything; each rule below names back exactly
# what ghpulse ships. An unlisted file is invisible to git and can never be
# committed by accident — which is the point, because this working tree also
# holds .env, a .venv, node_modules and scratch analysis.
#
# The mechanic, because the pattern fails silently without it: git does not
# look inside a directory it has already ignored. So every kept directory is
# re-opened (`!dir/`), its contents denied again (`dir/*`), and its files are
# named back by a glob SCOPED to that directory. That scoping is the point —
# it is what stops a `!*.py` from reaching into `__pycache__/` or `.venv/`.
#
# Adding a file whose type is not already named back for its directory means
# adding a rule here. `git status` will NOT tell you the file is missing; it
# simply never appears. `git check-ignore -v <path>` names the rule hiding it.

*

# ---- repository root ------------------------------------------------------
!/.gitignore
!/.gitmodules
!/AGENTS.md
!/CONTRIBUTING.md
!/README.md
!/VERSION
!/pyrightconfig.json
!/ruff.toml
!/requirements-dev.txt
!/requirements-test.txt
!/setup.cfg

# ---- .github/ — CI workflows and dependabot -------------------------------
!/.github/
/.github/*
!/.github/dependabot.yml
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml

# ---- .superpowers/ — committed SDD run records -----------------------------
!/.superpowers/
/.superpowers/*
!/.superpowers/sdd/
/.superpowers/sdd/*
!/.superpowers/sdd/*/
/.superpowers/sdd/*/*
!/.superpowers/sdd/*/*.html
!/.superpowers/sdd/*/*.md

# ---- backend/ — FastAPI app ------------------------------------------------
# `!/backend/*.py` deliberately has no `**`: it matches only files directly
# in backend/, so backend/__pycache__/ stays denied by `/backend/*` and git
# never descends into it.
!/backend/
/backend/*
!/backend/*.py
!/backend/.env.example
!/backend/requirements.txt
!/backend/schema.sql

# ---- docs/ — design docs and specs -----------------------------------------
!/docs/
/docs/*
!/docs/*.html
!/docs/*.md
!/docs/*.txt
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/plans/
/docs/superpowers/plans/*
!/docs/superpowers/plans/*.html
!/docs/superpowers/plans/*.md
!/docs/superpowers/specs/
/docs/superpowers/specs/*
!/docs/superpowers/specs/*.html
!/docs/superpowers/specs/*.md

# ---- examples/ — sample systemd unit ---------------------------------------
!/examples/
/examples/*
!/examples/*.service

# ---- public/ — static assets served at / -----------------------------------
!/public/
/public/*
!/public/*.css
!/public/*.html

# ---- scripts/ — CI entry points too big to live in a `run:` block ----------
!/scripts/
/scripts/*
!/scripts/*.sh
!/scripts/pre-push
!/scripts/ci/
/scripts/ci/*
!/scripts/ci/*.py

# ---- src/ — React JSX modules served at /src/* -----------------------------
!/src/
/src/*
!/src/*.js
!/src/*.jsx

# ---- tests/ — pytest suite and its JSON snapshots ---------------------------
!/tests/
/tests/*
!/tests/*.py
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/*.json

# ---- vendor/ — the pinned gh-widgets submodule -----------------------------
# The submodule is a GITLINK, not a directory of files: git tracks the single
# entry `vendor/gh-widgets` at a pinned commit. Naming it back is what keeps
# `git submodule` able to see it; the submodule's own contents are governed by
# its own .gitignore inside its own repository, not by this file.
!/vendor/
/vendor/*
!/vendor/gh-widgets
