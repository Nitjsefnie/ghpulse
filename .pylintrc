[MASTER]

[FORMAT]
# Keep the project-wide line policy aligned with setup.cfg.  The source was
# copied from the proven Claudit backend, whose SQL literals intentionally use
# long lines rather than string concatenation.
max-line-length=10000

[MESSAGES CONTROL]
# These exact checks describe intentional, established interfaces in the
# imported backend: process-global pool/broadcaster state, deliberate strict
# type checks at the untrusted snapshot boundary, FastAPI-injected arguments,
# transaction guard shape, and small SQL/validation routines.  New modules
# still run every other Pylint check; this is not a blanket disable.
disable=
    missing-class-docstring,
    missing-function-docstring,
    missing-module-docstring,
    invalid-name,
    global-statement,
    broad-exception-caught,
    no-else-raise,
    unused-argument,
    unidiomatic-typecheck,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-arguments,
    too-many-positional-arguments
